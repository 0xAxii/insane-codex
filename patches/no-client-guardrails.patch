 use super::SharedCliOptions;
 
+#[test]
+fn enables_yolo_when_permission_mode_is_unspecified() {
+    let mut options = SharedCliOptions::default();
+
+    options.enable_yolo_by_default(/*approval_policy_explicit*/ false);
+
+    assert!(options.dangerously_bypass_approvals_and_sandbox);
+}
+
+#[test]
+fn explicit_permission_modes_override_default_yolo() {
+    let mut sandbox = SharedCliOptions {
+        sandbox_mode: Some(crate::SandboxModeCliArg::ReadOnly),
+        ..Default::default()
+    };
+    sandbox.enable_yolo_by_default(/*approval_policy_explicit*/ false);
+    assert!(!sandbox.dangerously_bypass_approvals_and_sandbox);
+
+    let mut auto_review = SharedCliOptions {
+        auto_review: true,
+        ..Default::default()
+    };
+    auto_review.enable_yolo_by_default(/*approval_policy_explicit*/ false);
+    assert!(!auto_review.dangerously_bypass_approvals_and_sandbox);
+
+    let mut approval = SharedCliOptions::default();
+    approval.enable_yolo_by_default(/*approval_policy_explicit*/ true);
+    assert!(!approval.dangerously_bypass_approvals_and_sandbox);
+}
